# Which provider serves the models. gemini | groq | openai
PROVIDER=gemini

# Gemini free tier — no credit card required.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed if you switch PROVIDER
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional model overrides. Leave blank to use the provider defaults.
# Run `python -m api.providers --list` to see what your key can access.
EMBED_MODEL=
CHAT_MODEL=
STRATEGY=recursive-800-overlap-100
